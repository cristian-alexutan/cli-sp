# Copy this file to .env and fill in your own values.

# Spotify Web API credentials, from your app at https://developer.spotify.com/dashboard
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
# Must match a redirect URI registered in your app's settings
REDIRECT_URL=http://127.0.0.1:8888/callback

# Optional: Spotify Soloist (headless player), key from https://developer.spotify.com/dashboard/soloist
# If set and soloist is installed, cli-sp uses it instead of the desktop app.
SOLOIST_API_KEY=

# Optional: name of the Spotify Connect device cli-sp plays on (default: cli-sp)
SPOTIFY_DEVICE_NAME=cli-sp
